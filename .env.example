# Copy to .env and fill in. .env is never committed.
ANTHROPIC_API_KEY=

# Models are defaults. The prompt registry overrides them per prompt.
READING_MODEL=claude-sonnet-5-5
ANALYSIS_MODEL=claude-opus-5-5

# Debugging aid. Use hashes to stop storing prompt and output content.
AI_RUN_CAPTURE=full

# Host ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
DB_PORT=5433

# Folder with the starter kit files, mounted read-only into the backend
STARTER_KIT_DIR=./project_requirmnt/Galaxy_Immigration_starter-kit
